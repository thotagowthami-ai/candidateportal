    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Candidate User\",\n  \"email\": \"candidate@example.com\",\n  \"password\": \"StrongPassword@123\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try {",
                  "  json = pm.response.json();",
                  "} catch (e) {",
                  "  json = {};",
                  "}",
                  "if (json.access_token) {",
                  "  pm.environment.set('accessToken', json.access_token);",
                  "} else if (json.token) {",
                  "  pm.environment.set('accessToken', json.token);",
                  "}",
                  "if (json.refresh_token) {",
                  "  pm.environment.set('refreshToken', json.refresh_token);",
                  "}",
                  "pm.test('Login endpoint is reachable', function () {",
                  "  pm.expect(pm.response.code).to.be.below(500);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@example.com\",\n  \"password\": \"StrongPassword@123\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/refresh"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/auth/me"
          }
        }
      ]
