          }
        }
      ]
    },
    {
      "name": "Contact",
      "item": [
        {
          "name": "Contact Team",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{contactFirstName}}\",\n  \"lastName\": \"{{contactLastName}}\",\n  \"email\": \"{{contactEmail}}\",\n  \"phone\": \"{{contactPhone}}\"\n}"
            },
            "url": "{{baseUrl}}{{authContactPath}}"
          }
        }
      ]
    },
    {
      "name": "Registration Flow",
      "item": [
        {
          "name": "Initiate Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"{{firstName}}\",\n  \"middleName\": \"{{middleName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"{{testPhone}}\"\n}"
            },
            "url": "{{baseUrl}}{{authInitiatePath}}"
          }
        },
        {
          "name": "Verify Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"otp\": \"{{registrationOtp}}\"\n}"
            },
            "url": "{{baseUrl}}{{authVerifyOtpPath}}"
          }
        },
        {
          "name": "Resend Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\"\n}"
            },
            "url": "{{baseUrl}}{{authResendOtpPath}}"
          }
        },
        {
          "name": "Create User With Resume",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = {};",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "if (json.accessToken) pm.environment.set('accessToken', json.accessToken);",
                  "if (json.access_token) pm.environment.set('accessToken', json.access_token);",
                  "if (json.user && json.user.id) pm.environment.set('userId', String(json.user.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "firstName",
                  "value": "{{firstName}}",
                  "type": "text"
                },
                {
                  "key": "middleName",
                  "value": "{{middleName}}",
                  "type": "text"
                },
                {
                  "key": "lastName",
                  "value": "{{lastName}}",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "{{testEmail}}",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "{{testPhone}}",
                  "type": "text"
                },
                {
                  "key": "resume",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}{{usersCreatePath}}"
          }
        }
      ]
    },
