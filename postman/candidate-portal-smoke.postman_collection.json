{
  "info": {
    "_postman_id": "478281f8-6047-43bc-a893-9c812bc9ad2b",
    "name": "Candidate Portal API (CI Smoke)",
    "description": "Small, stable CI smoke tests for deployed Candidate Portal API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Root Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deployment is reachable', function () {",
                  "  pm.expect(pm.response.code).to.be.below(500);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.variables.get('testEmail');",
                  "const password = pm.variables.get('testPassword');",
                  "const hasCreds = Boolean(email && password);",
                  "const strict = String(pm.variables.get('strictSmoke') || 'false').toLowerCase() === 'true';",
                  "if (hasCreds) {",
                  "  pm.test('Login succeeds with CI credentials', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  });",
                  "  let json = {};",
                  "  try { json = pm.response.json(); } catch (e) {}",
                  "  if (json.access_token) pm.environment.set('accessToken', json.access_token);",
                  "  if (json.token) pm.environment.set('accessToken', json.token);",
                  "} else {",
                  "  if (strict) {",
                  "    pm.test('Login endpoint exists', function () {",
                  "      pm.expect(pm.response.code).to.not.equal(404);",
                  "    });",
                  "  } else {",
                  "    pm.test('Login endpoint check is optional in non-strict mode', function () {",
                  "      pm.expect(true).to.equal(true);",
                  "    });",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": "{{baseUrl}}{{authLoginPath}}"
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "List Jobs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const strict = String(pm.variables.get('strictSmoke') || 'false').toLowerCase() === 'true';",
                  "if (strict) {",
                  "  pm.test('Jobs route exists', function () {",
                  "    pm.expect(pm.response.code).to.not.equal(404);",
                  "  });",
                  "} else {",
                  "  pm.test('Jobs route check is optional in non-strict mode', function () {",
                  "    pm.expect(true).to.equal(true);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{jobsPath}}"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://cportal-production.up.railway.app"
    },
    {
      "key": "apiPrefix",
      "value": ""
    },
    {
      "key": "authLoginPath",
      "value": "/auth/login"
    },
    {
      "key": "jobsPath",
      "value": "/jobs"
    },
    {
      "key": "strictSmoke",
      "value": "false"
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ]
}
