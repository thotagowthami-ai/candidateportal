    {
      "name": "Users - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response && response.accessToken) {",
              "  pm.collectionVariables.set('authToken', response.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
