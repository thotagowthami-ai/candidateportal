      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function saveAuthValues() {",
          "  let json;",
          "  try { json = pm.response.json(); } catch (e) { return; }",
          "  const token = json.accessToken || json.token || json.jwt || json?.data?.accessToken || json?.data?.token;",
          "  if (token) pm.environment.set('accessToken', token);",
          "  const user = json.user || json.data?.user || json;",
          "  if (user?.id) pm.environment.set('userId', user.id);",
          "  if (user?.candidateId) pm.environment.set('candidateId', user.candidateId);",
          "  if (user?.email) pm.environment.set('candidateEmail', user.email);",
          "}",
          "saveAuthValues();"
        ]
      }
    }
  ],
