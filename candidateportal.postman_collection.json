{
  "info": {
    "name": "Candidate Portal API (Production)",
    "_postman_id": "c7b5a3d2-1a1b-4a4d-9c5e-0b0dbca2a999",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for Candidate Portal backend (Railway)."
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{rootUrl}}/"
      },
      "response": []
    },
    {
      "name": "Auth - Initiate Registration",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/initiate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"phone\": \"+1-555-000-0000\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Auth - Send OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/send-otp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Auth - Resend OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/resend-otp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Auth - Verify OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/verify-otp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"otp\": \"123456\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Users - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/users/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Users - Me",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/users/me"
      },
      "response": []
    },
    {
      "name": "Users - Me (Semantic)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/users/me/semantic"
      },
      "response": []
    },
    {
      "name": "Users - Create (With Resume Upload)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/users/create",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "firstName", "value": "Test", "type": "text" },
            { "key": "lastName", "value": "User", "type": "text" },
            { "key": "email", "value": "test@example.com", "type": "text" },
            { "key": "phone", "value": "+1-555-000-0000", "type": "text" },
            { "key": "resume", "type": "file", "src": "" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Users - Dev Test Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/users/test-create",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Dev\",\n  \"lastName\": \"User\",\n  \"email\": \"dev@example.com\",\n  \"phone\": \"+1-555-111-1111\",\n  \"resumeUrl\": \"https://example.com/resume.pdf\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Uploads - Resume",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/uploads/resume",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Match - JD",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/match/jd",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jobDescription\": \"Paste job description text here\",\n  \"resumeText\": \"Paste resume text here\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Match - JD (Me)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/match/jd/me",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jobDescription\": \"Paste job description text here\",\n  \"resumeText\": \"Paste resume text here\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Match - JD (By User ID)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/match/jd/user/{{userId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jobDescription\": \"Paste job description text here\",\n  \"resumeText\": \"Paste resume text here\"\n}"
        }
      },
      "response": []
    },
    {
      "name": "Match - JD Save (Recruiting)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/match/jd/save?jobDescriptionId={{jobDescriptionId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jobDescription\": \"Paste job description text here\",\n  \"resumeText\": \"Paste resume text here\"\n}"
        }
      },
      "response": []
    }
  ]
}
