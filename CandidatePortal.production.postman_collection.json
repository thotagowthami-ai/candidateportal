{
  "info": {
    "name": "Candidate Portal - Production API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Initiate Registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Gowthami\",\n  \"lastName\": \"Thota\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "initiate"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response && response.accessToken) {",
                  "  pm.environment.set('authToken', response.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile (Semantic)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/semantic",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "semantic"]
            }
          }
        },
        {
          "name": "Update Profile Details",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Gowthami\",\n  \"lastName\": \"Thota\",\n  \"headline\": \"Software Engineer\",\n  \"location\": \"India\",\n  \"industry\": \"Technology\",\n  \"summary\": \"Experienced developer specialize in React and Node.js.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/update-profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "update-profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload New Resume",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "resume",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "upload"]
            }
          }
        }
      ]
    },
    {
      "name": "Matchmaking",
      "item": [
        {
          "name": "Match JD vs Me",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Looking for a React developer with Node.js experience.\",\n  \"threshold\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/match/jd/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "match", "jd", "me"]
            }
          }
        }
      ]
    }
  ]
}
