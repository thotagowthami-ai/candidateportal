{
  "info": {
    "name": "Candidate Portal API - Deployed Env",
    "description": "Comprehensive Postman collection for the Candidate Portal Backend, covering Auth, Users, Matches, Uploads, and SMS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://your-deployed-backend-url.com",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "your_jwt_token_here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "App",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Initiate Registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"+1234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "initiate"]
            }
          }
        },
        {
          "name": "Initiate Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/initiate-login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "initiate-login"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Get Semantic Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me/semantic",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "semantic"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/update-profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "update-profile"]
            }
          }
        },
        {
          "name": "Upload Resume (Replace)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/users/upload",
              "host": ["{{baseUrl}}"],
              "path": ["users", "upload"]
            }
          }
        },
        {
          "name": "Download Resume",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/:candidateId/resume",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":candidateId", "resume"],
              "variable": [
                {
                  "key": "candidateId",
                  "value": "12345"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Matches",
      "item": [
        {
          "name": "Match Job Description for Me",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Software Engineer\",\n  \"description\": \"Looking for a skilled backend developer...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/match/jd/me",
              "host": ["{{baseUrl}}"],
              "path": ["match", "jd", "me"]
            }
          }
        },
        {
          "name": "Save Matches for Job (Admin/Recruiter)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Software Engineer\",\n  \"description\": \"Full stack role\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/match/jd/save?jobDescriptionId=123",
              "host": ["{{baseUrl}}"],
              "path": ["match", "jd", "save"],
              "query": [
                {
                  "key": "jobDescriptionId",
                  "value": "123"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Notify Candidate (SMS)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+1234567890\",\n  \"message\": \"Your verification code is: 1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/notify-candidate",
              "host": ["{{baseUrl}}"],
              "path": ["notify-candidate"]
            }
          }
        }
      ]
    }
  ]
}
